<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5"/>

  <!-- SEO: title + description (per-page) -->
  <title><%= title %></title>
  <meta name="description" content="<%= typeof description !== 'undefined' ? description : 'The Raw Studios — Professional music and dance academy in Zirakpur, Punjab. Singing, Guitar, Piano, Kathak, Bhangra and more.' %>"/>
  <meta name="keywords" content="music academy Zirakpur, dance classes Punjab, singing lessons, guitar classes, piano lessons, Kathak, Bhangra, The Raw Studios"/>
  <meta name="robots" content="index, follow"/>
  <link rel="canonical" href="<%= typeof canonical !== 'undefined' ? canonical : 'https://therawstudios.in' %>"/>

  <!-- Open Graph -->
  <meta property="og:type" content="website"/>
  <meta property="og:site_name" content="The Raw Studios"/>
  <meta property="og:title" content="<%= title %>"/>
  <meta property="og:description" content="<%= typeof description !== 'undefined' ? description : 'The Raw Studios — Professional music and dance academy in Zirakpur, Punjab.' %>"/>
  <meta property="og:url" content="<%= typeof canonical !== 'undefined' ? canonical : 'https://therawstudios.in' %>"/>
  <meta property="og:image" content="<%= typeof ogImage !== 'undefined' ? ogImage : 'https://therawstudios.in/images/logo.png' %>"/>
  <meta property="og:image:width" content="1200"/>
  <meta property="og:image:height" content="630"/>
  <meta property="og:locale" content="en_IN"/>

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image"/>
  <meta name="twitter:title" content="<%= title %>"/>
  <meta name="twitter:description" content="<%= typeof description !== 'undefined' ? description : 'The Raw Studios — Professional music and dance academy in Zirakpur, Punjab.' %>"/>
  <meta name="twitter:image" content="<%= typeof ogImage !== 'undefined' ? ogImage : 'https://therawstudios.in/images/logo.png' %>"/>

  <!-- Bootstrap 5 -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"/>
  <!-- Font Awesome 6 -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Bangers&family=Bebas+Neue&family=Great+Vibes&family=Playfair+Display:ital,wght@0,600;0,700;1,600&family=Poppins:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@400;500;700&display=swap" rel="stylesheet"/>
  <!-- Swiper -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"/>
  <!-- Custom CSS -->
  <link rel="stylesheet" href="/css/style.css"/>
  <!-- Favicon -->
  <link rel="icon" type="image/png" href="/images/logo.png"/>
  <link rel="apple-touch-icon" href="/images/logo.png"/>

  <!-- Google Analytics 4 -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-TS2PM3XMP3"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-TS2PM3XMP3');
  </script>

  <!-- Meta Pixel -->
  <script>
    !function(f,b,e,v,n,t,s)
    {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
    n.callMethod.apply(n,arguments):n.queue.push(arguments)};
    if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
    n.queue=[];t=b.createElement(e);t.async=!0;
    t.src=v;s=b.getElementsByTagName(e)[0];
    s.parentNode.insertBefore(t,s)}(window, document,'script',
    'https://connect.facebook.net/en_US/fbevents.js');
    fbq('init', '1355074056674540');
    fbq('track', 'PageView');
  </script>
  <noscript><img height="1" width="1" style="display:none"
    src="https://www.facebook.com/tr?id=1355074056674540&ev=PageView&noscript=1"
  /></noscript>

  <!-- LocalBusiness JSON-LD Schema -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": "The Raw Studios",
    "description": "Professional music and dance academy in Zirakpur, Punjab offering Singing, Guitar, Piano, Kathak, Bhangra and more.",
    "url": "https://therawstudios.in",
    "telephone": "+919754444450",
    "email": "therawstudioofficial@gmail.com",
    "image": "https://therawstudios.in/images/logo.png",
    "priceRange": "₹₹",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "First Floor, Sodhi Complex, SCO 1, VIP Rd, near SGR Clinic, Rail Vihar",
      "addressLocality": "Zirakpur",
      "addressRegion": "Punjab",
      "postalCode": "140603",
      "addressCountry": "IN"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": "30.6436",
      "longitude": "76.8142"
    },
    "openingHoursSpecification": [
      {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"],
        "opens": "09:00",
        "closes": "20:00"
      }
    ],
    "sameAs": [
      "https://www.instagram.com/therawstudioofficial"
    ]
  }
  </script>
</head>
<body>

<!-- ══════════════════════════════════════════════
     FULL-SCREEN PAGE LOADER (dismissed by JS on load)
═══════════════════════════════════════════════ -->
<div id="trs-loader" aria-hidden="true">
  <div class="loader-orb lo-1"></div>
  <div class="loader-orb lo-2"></div>
  <div class="loader-orb lo-3"></div>
  <div class="loader-staff-lines" aria-hidden="true">
    <span></span><span></span><span></span><span></span><span></span>
  </div>
  <div class="loader-content">
    <i class="fa-solid fa-music loader-music-icon"></i>
    <div class="loader-brand-text">The Raw Studios</div>
    <p class="loader-tagline">Music &nbsp;&middot;&nbsp; Dance &nbsp;&middot;&nbsp; Art</p>
    <div class="loader-progress-wrap">
      <div class="loader-progress-track">
        <div class="loader-progress-fill"></div>
      </div>
    </div>
    <div class="loader-notes-row" aria-hidden="true">
      <span>&#9834;</span><span>&#9835;</span><span>&#9833;</span><span>&#9836;</span><span>&#9837;</span>
    </div>
  </div>
</div>
