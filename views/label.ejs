<%- include('partials/head', {title}) %>
<%- include('partials/navbar') %>

<!-- Page Hero -->
<section class="page-hero" id="label-page">
  <div class="page-hero-bg"></div>
  <div class="container text-center">
    <span class="section-tag gsap-fade-up" data-delay="0.1">Record Label</span>
    <h1 class="page-hero-title gsap-fade-up" data-delay="0.2">TRS <span class="text-gradient">Label</span></h1>
    <p class="page-hero-subtitle gsap-fade-up" data-delay="0.35">Watch our live performances, student showcases, and original recordings.</p>
  </div>
</section>

<!-- ══════════════════════════════════════════════
     STUDENT REELS & SHORTS
═══════════════════════════════════════════════ -->
<section class="trs-section reels-carousel-section">
  <div class="container">
    <div class="section-header text-center mb-5">
      <span class="section-tag gsap-reveal reels-section-tag">Student Reels</span>
      <h2 class="section-title gsap-reveal reels-section-title">Student <span class="text-gradient">Reels &amp; Shorts</span></h2>
      <p class="section-subtitle gsap-reveal reels-section-sub">Moments from our classes, performances &amp; backstage life on Instagram.</p>
    </div>

    <div class="reels-white-box gsap-reveal">
      <div class="reels-swiper-outer">
        <div class="swiper reels-carousel-swiper">
          <div class="swiper-wrapper">

            <div class="swiper-slide d-flex justify-content-center py-3">
              <div class="phone-mockup">
                <div class="phone-camera-notch"></div>
                <div class="phone-screen">
                  <blockquote class="instagram-media" data-instgrm-permalink="https://www.instagram.com/reel/DYeoRlQzCzc/" data-instgrm-version="14" style="background:#FFF;border:0;margin:0;max-width:100%;min-width:100%;padding:0;width:100%;"></blockquote>
                </div>
                <div class="phone-home-bar"></div>
              </div>
            </div>

            <div class="swiper-slide d-flex justify-content-center py-3">
              <div class="phone-mockup">
                <div class="phone-camera-notch"></div>
                <div class="phone-screen">
                  <blockquote class="instagram-media" data-instgrm-permalink="https://www.instagram.com/reel/DT7ukPjE3qX/" data-instgrm-version="14" style="background:#FFF;border:0;margin:0;max-width:100%;min-width:100%;padding:0;width:100%;"></blockquote>
                </div>
                <div class="phone-home-bar"></div>
              </div>
            </div>

            <div class="swiper-slide d-flex justify-content-center py-3">
              <div class="phone-mockup">
                <div class="phone-camera-notch"></div>
                <div class="phone-screen">
                  <blockquote class="instagram-media" data-instgrm-permalink="https://www.instagram.com/reel/DKzMWJ8xEbG/" data-instgrm-version="14" style="background:#FFF;border:0;margin:0;max-width:100%;min-width:100%;padding:0;width:100%;"></blockquote>
                </div>
                <div class="phone-home-bar"></div>
              </div>
            </div>

            <div class="swiper-slide d-flex justify-content-center py-3">
              <div class="phone-mockup">
                <div class="phone-camera-notch"></div>
                <div class="phone-screen">
                  <blockquote class="instagram-media" data-instgrm-permalink="https://www.instagram.com/reel/DUvJUveE8bm/" data-instgrm-version="14" style="background:#FFF;border:0;margin:0;max-width:100%;min-width:100%;padding:0;width:100%;"></blockquote>
                </div>
                <div class="phone-home-bar"></div>
              </div>
            </div>

          </div>
        </div>

        <div class="reviews-nav-row mt-3">
          <button class="swiper-nav-btn reels-prev" aria-label="Previous reel">
            <i class="fa-solid fa-chevron-left"></i>
          </button>
          <div class="swiper-pagination reels-pagination"></div>
          <button class="swiper-nav-btn reels-next" aria-label="Next reel">
            <i class="fa-solid fa-chevron-right"></i>
          </button>
        </div>
      </div>
    </div>
    <script async src="//www.instagram.com/embed.js"></script>

    <div class="text-center mt-4 gsap-reveal">
      <a href="https://www.instagram.com/therawstudiosofficial" target="_blank" rel="noopener" class="btn btn-outline-reels">
        <i class="fa-brands fa-instagram me-2"></i>Follow @therawstudiosofficial
      </a>
    </div>
  </div>
</section>

<script>
(function() {
  function initReelsSwiper() {
    if (typeof Swiper === 'undefined') { setTimeout(initReelsSwiper, 100); return; }
    new Swiper('.reels-carousel-swiper', {
      loop: false,
      rewind: true,
      slidesPerView: 1,
      spaceBetween: 0,
      autoplay: { delay: 5000, disableOnInteraction: false },
      pagination: { el: '.reels-pagination', clickable: true },
      navigation: { nextEl: '.reels-next', prevEl: '.reels-prev' },
      on: {
        init: function() {
          if (window.instgrm) window.instgrm.Embeds.process();
        }
      }
    });
  }
  document.addEventListener('DOMContentLoaded', initReelsSwiper);
  window.addEventListener('load', function() {
    if (window.instgrm) window.instgrm.Embeds.process();
  });
})();
</script>

<!-- ══════════════════════════════════════════════
     RECORDED PERFORMANCES
═══════════════════════════════════════════════ -->
<section class="trs-section label-section" style="background:#F8F8F8;">
  <div class="container">
    <div class="section-header text-center mb-5">
      <span class="section-tag gsap-reveal">Studio Sessions</span>
      <h2 class="section-title gsap-reveal">Recorded <span class="text-gradient">Performances</span></h2>
      <p class="section-subtitle gsap-reveal">Explore our studio recordings, recitals, and original sessions.</p>
    </div>

    <div class="row g-4 videos-grid">
      <% recordedVideos.forEach((video, i) => { %>
      <div class="col-sm-6 col-lg-4 gsap-card" data-index="<%= i + liveVideos.length %>">
        <div class="video-card" data-videoid="<%= video.id %>">
          <div class="video-thumbnail" id="thumb-<%= i + liveVideos.length %>">
            <img
              src="https://img.youtube.com/vi/<%= video.id %>/maxresdefault.jpg"
              alt="<%= video.title %>"
              onerror="this.src='https://img.youtube.com/vi/<%= video.id %>/hqdefault.jpg'"
              class="thumb-img"
              loading="lazy"
            />
            <div class="video-overlay">
              <div class="play-btn-wrap">
                <div class="play-btn"><i class="fa-solid fa-play"></i></div>
                <div class="play-ripple"></div>
                <div class="play-ripple delay1"></div>
              </div>
            </div>
          </div>
          <div class="video-iframe-wrap" id="iframe-<%= i + liveVideos.length %>" style="display:none;"></div>
          <div class="video-info">
            <span class="video-type-badge" style="background:#222; color:#fff; font-size:0.7rem; padding:2px 10px; border-radius:20px; display:inline-block; margin-bottom:6px;"><i class="fa-solid fa-record-vinyl me-1"></i>Recorded</span>
            <h4 class="video-title"><%= video.title %></h4>
            <p class="video-artist"><i class="fa-solid fa-user-music me-1"></i><%= video.artist %></p>
            <a href="https://www.youtube.com/watch?v=<%= video.id %>" target="_blank" rel="noopener" class="youtube-link">
              <i class="fa-brands fa-youtube me-1"></i> Watch on YouTube
            </a>
          </div>
        </div>
      </div>
      <% }) %>
    </div>

    <div class="text-center mt-5 gsap-reveal">
      <p class="label-cta-text">Are you an independent artist? Partner with us!</p>
      <a href="/contact" class="btn btn-primary-trs btn-magnetic">
        <i class="fa-solid fa-record-vinyl me-2"></i>Collaborate With TRS Label
      </a>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
