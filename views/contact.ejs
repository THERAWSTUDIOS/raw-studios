<%- include('partials/head', {title}) %>
<%- include('partials/navbar') %>

<!-- Page Hero -->
<section class="page-hero contact-hero" id="contact-page">
  <div class="page-hero-bg"></div>
  <div class="container text-center">
    <span class="section-tag gsap-fade-up" data-delay="0.1">Let's Talk</span>
    <h1 class="page-hero-title gsap-fade-up" data-delay="0.2">Get in <span class="text-gradient">Touch</span></h1>
    <p class="page-hero-subtitle gsap-fade-up" data-delay="0.35">We are here to answer any question you may have.</p>
  </div>
</section>

<!-- Contact Section -->
<section class="trs-section contact-section">
  <div class="container">
    <div class="row g-5 align-items-start">
      <!-- Contact Info -->
      <div class="col-lg-5 gsap-reveal" data-dir="left">
        <div class="contact-info-card">
          <h2 class="contact-info-title">Contact <span class="text-gradient">Details</span></h2>
          <p class="contact-info-subtitle">Speak to our friendly team — we'd love to hear from you!</p>

          <div class="contact-detail-item">
            <div class="cd-icon" style="--ci: #4ea8f3"><i class="fa-solid fa-envelope"></i></div>
            <div>
              <h5>Email Us</h5>
              <a href="mailto:therawstudioofficial@gmail.com">therawstudioofficial@gmail.com</a>
            </div>
          </div>
          <div class="contact-detail-item">
            <div class="cd-icon" style="--ci: #b06cf4"><i class="fa-solid fa-phone"></i></div>
            <div>
              <h5>Call Us</h5>
              <p>Mon–Sun, 8am – 8pm</p>
              <a href="tel:+919754444450">+91 9754444450</a>
            </div>
          </div>
          <div class="contact-detail-item">
            <div class="cd-icon" style="--ci: #4fe8c8"><i class="fa-solid fa-location-dot"></i></div>
            <div>
              <h5>Visit Us</h5>
              <p>The Raw Studios, First Floor, Sodhi Complex, SCO 1, VIP Rd, near SGR Clinic, Rail Vihar, Zirakpur, Punjab</p>
            </div>
          </div>

          <!-- Map placeholder -->
          <div class="map-embed">
            <iframe
              src="https://maps.google.com/maps?q=Rail+Vihar+Zirakpur+Punjab&output=embed"
              width="100%"
              height="220"
              style="border:0;border-radius:12px;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="The Raw Studios Location"
            ></iframe>
          </div>

          <div class="contact-social mt-4">
            <a href="#" class="social-link" aria-label="Facebook"><i class="fa-brands fa-facebook-f"></i></a>
            <a href="https://www.instagram.com/therawstudiosofficial" target="_blank" class="social-link" aria-label="Instagram"><i class="fa-brands fa-instagram"></i></a>
            <a href="#" class="social-link" aria-label="YouTube"><i class="fa-brands fa-youtube"></i></a>
          </div>
        </div>
      </div>

      <!-- Contact Form -->
      <div class="col-lg-7 gsap-reveal" data-dir="right">
        <div class="contact-form-card">
          <h2 class="contact-form-title">Send a Message <span style="font-style:normal;">👍🏻</span></h2>
          <p class="contact-form-subtitle">Fill out the form below and we'll get back to you within 24 hours.</p>

          <div id="successMsg" style="display:none" class="alert trs-alert-success" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i>We received your enquiry! Our team will reach out to you on WhatsApp shortly.
          </div>

          <form class="contact-form" id="contactForm" novalidate>
            <div class="row g-4">
              <div class="col-12">
                <div class="trs-form-group">
                  <label class="trs-label">Full Name <span class="required">*</span></label>
                  <div class="trs-input-wrap">
                    <i class="fa-solid fa-user input-icon"></i>
                    <input type="text" name="name" class="form-control trs-input-field" placeholder="Your full name" required/>
                  </div>
                </div>
              </div>
              <div class="col-md-6">
                <div class="trs-form-group">
                  <label class="trs-label">Phone Number <span class="required">*</span></label>
                  <div class="trs-input-wrap">
                    <i class="fa-solid fa-phone input-icon"></i>
                    <input type="tel" name="phone" class="form-control trs-input-field" placeholder="+91 XXXXX XXXXX" required/>
                  </div>
                </div>
              </div>
              <div class="col-md-6">
                <div class="trs-form-group">
                  <label class="trs-label">Email Address <span class="required">*</span></label>
                  <div class="trs-input-wrap">
                    <i class="fa-solid fa-envelope input-icon"></i>
                    <input type="email" name="email" class="form-control trs-input-field" placeholder="you@example.com" required/>
                  </div>
                </div>
              </div>
              <div class="col-12">
                <div class="trs-form-group">
                  <label class="trs-label">Course Interested In</label>
                  <div class="trs-input-wrap">
                    <i class="fa-solid fa-music input-icon"></i>
                    <select name="course" class="form-control trs-input-field trs-select">
                      <option value="">Select a course (optional)</option>
                      <option>Singing Classes</option>
                      <option>Guitar Classes</option>
                      <option>Piano Classes</option>
                      <option>Flute Classes</option>
                      <option>Drums</option>
                      <option>Cajon / Clapbox</option>
                      <option>Violin</option>
                      <option>Sitar</option>
                      <option>Western Dance</option>
                      <option>Classical Dance (Kathak)</option>
                      <option>Bhangra</option>
                      <option>Yoga</option>
                      <option>Other / General Enquiry</option>
                    </select>
                  </div>
                </div>
              </div>
              <div class="col-12">
                <div class="trs-form-group">
                  <label class="trs-label">Your Message / Concern</label>
                  <div class="trs-input-wrap">
                    <i class="fa-solid fa-comment-dots input-icon" style="top:1rem;transform:none"></i>
                    <textarea name="concern" class="form-control trs-input-field" placeholder="Tell us about your goals, questions, or any specific requirements…" rows="3" style="padding-top:.75rem;resize:vertical"></textarea>
                  </div>
                </div>
              </div>
              <div class="col-12">
                <label class="trs-lead-checkbox" id="leadLabel">
                  <input type="checkbox" id="confirmLead" name="is_lead"/>
                  <span class="lead-checkbox-box"><i class="fa-solid fa-check"></i></span>
                  <span class="lead-checkbox-text">I confirm the provided information is correct — connect me on <strong>WhatsApp</strong> instantly</span>
                  <span class="lead-wa-badge"><i class="fa-brands fa-whatsapp"></i></span>
                </label>
              </div>
            </div>

            <button type="submit" class="btn btn-submit-big btn-magnetic mt-4 w-100" id="submitBtn">
              <span class="btn-text"><i class="fa-solid fa-paper-plane me-2"></i>Send Message</span>
              <span class="btn-loading" style="display:none"><i class="fa-solid fa-spinner fa-spin me-2"></i>Sending…</span>
            </button>
          </form>

          <style>
            .trs-lead-checkbox{display:flex;align-items:center;gap:.75rem;cursor:pointer;padding:.85rem 1.1rem;border-radius:12px;border:1.5px solid rgba(0,0,0,0.12);background:rgba(37,211,102,0.03);transition:.3s}
            .trs-lead-checkbox:hover{border-color:rgba(37,211,102,0.4);background:rgba(37,211,102,0.07)}
            .trs-lead-checkbox input{display:none}
            .lead-checkbox-box{width:20px;height:20px;border-radius:5px;border:2px solid rgba(0,0,0,0.28);display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:.25s;color:#fff;font-size:.65rem}
            .trs-lead-checkbox input:checked ~ .lead-checkbox-box{background:#25d366;border-color:#25d366}
            .lead-checkbox-text{flex:1;font-size:.84rem;color:#555;transition:.25s}
            .trs-lead-checkbox input:checked ~ .lead-checkbox-box ~ .lead-checkbox-text{color:#222}
            .lead-wa-badge{background:rgba(37,211,102,0.12);color:#1a9f4f;border:1px solid rgba(37,211,102,0.35);border-radius:50px;padding:3px 10px;font-size:.78rem;flex-shrink:0;font-weight:600}
            .lead-active{border-color:rgba(37,211,102,0.5)!important;background:rgba(37,211,102,0.08)!important}
            .btn-submit-big{transition:background .3s,box-shadow .3s}
            .btn-submit-wa{background:linear-gradient(135deg,#25d366,#128c7e)!important;box-shadow:0 4px 20px rgba(37,211,102,0.35)!important}
          </style>
          <script>
          (function(){
            var form       = document.getElementById('contactForm');
            var cb         = document.getElementById('confirmLead');
            var label      = document.getElementById('leadLabel');
            var submitBtn  = document.getElementById('submitBtn');
            var successDiv = document.getElementById('successMsg');

            /* Pre-cache DOM elements — direct reads, zero ambiguity */
            var nameEl    = form.querySelector('input[name="name"]');
            var phoneEl   = form.querySelector('input[name="phone"]');
            var emailEl   = form.querySelector('input[name="email"]');
            var courseEl  = form.querySelector('select[name="course"]');
            var concernEl = form.querySelector('textarea[name="concern"]');

            function showErr(fieldName, msg) {
              var el = form.querySelector('[name="' + fieldName + '"]');
              if (!el) return;
              el.style.borderColor = '#e53e3e';
              var err = form.querySelector('.trs-err-' + fieldName);
              if (!err) {
                err = document.createElement('p');
                err.className = 'trs-err-' + fieldName;
                err.style.cssText = 'color:#e53e3e;font-size:.78rem;margin:4px 0 0 4px;';
                el.closest('.trs-input-wrap').after(err);
              }
              err.textContent = msg;
            }
            function clearErr(fieldName) {
              var el = form.querySelector('[name="' + fieldName + '"]');
              if (el) el.style.borderColor = '';
              var errEl = form.querySelector('.trs-err-' + fieldName);
              if (errEl) errEl.textContent = '';
            }
            function clearAllErr() {
              ['name','phone','email'].forEach(clearErr);
            }

            cb.addEventListener('change', function() {
              label.classList.toggle('lead-active', cb.checked);
              submitBtn.classList.toggle('btn-submit-wa', cb.checked);
              submitBtn.querySelector('.btn-text').innerHTML = cb.checked
                ? '<i class="fa-brands fa-whatsapp me-2"></i>Send &amp; Open WhatsApp'
                : '<i class="fa-solid fa-paper-plane me-2"></i>Send Message';
            });

            form.addEventListener('submit', async function(e) {
              e.preventDefault();
              e.stopPropagation();
              clearAllErr();

              /* Read directly from DOM — avoids window.name / FormData edge cases */
              var fullName   = nameEl    ? nameEl.value.trim()    : '';
              var rawPhone   = phoneEl   ? phoneEl.value.trim()   : '';
              var emailVal   = emailEl   ? emailEl.value.trim()   : '';
              var courseVal  = courseEl  ? courseEl.value         : '';
              var concernVal = concernEl ? concernEl.value.trim() : '';
              var openWA     = cb.checked;

              /* ── Validate ── */
              var valid = true;
              if (!fullName) {
                showErr('name', 'Full name is required.');
                valid = false;
              }

              var phoneDigits = rawPhone.replace(/\D/g, '');
              if (!phoneDigits || !/^[6-9]\d{9}$/.test(phoneDigits)) {
                showErr('phone', 'Enter a valid 10-digit Indian mobile number (starts with 6–9).');
                valid = false;
              }

              if (!emailVal || !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(emailVal)) {
                showErr('email', 'Enter a valid email address.');
                valid = false;
              }

              if (!valid) return; /* ← hard stop — WhatsApp never opens on bad input */

              /* ── Build WhatsApp message BEFORE fetch/reset ── */
              var waMsg = openWA
                ? 'Hello! I found your contact from The Raw Studios website.\n' +
                  '*Name:* ' + fullName + '\n' +
                  '*Phone:* ' + phoneDigits + '\n' +
                  '*Email:* ' + emailVal + '\n' +
                  (courseVal  ? '*Course:* '  + courseVal  + '\n' : '') +
                  (concernVal ? '*Message:* ' + concernVal + '\n' : '') +
                  'I would like to know more about your courses and timings. Please guide me!'
                : null;

              var btnText    = submitBtn.querySelector('.btn-text');
              var btnLoading = submitBtn.querySelector('.btn-loading');
              btnText.style.display    = 'none';
              btnLoading.style.display = '';
              submitBtn.disabled = true;

              try {
                var res = await fetch('/contact', {
                  method: 'POST',
                  headers: {'Content-Type': 'application/x-www-form-urlencoded'},
                  body: new URLSearchParams({
                    name: fullName, phone: phoneDigits, email: emailVal,
                    course: courseVal, concern: concernVal, is_lead: '1'
                  })
                });
                var data = await res.json();
                if (!res.ok) {
                  showErr('name', data.error || 'Something went wrong. Please try again.');
                  return;
                }

                form.reset();
                clearAllErr();
                label.classList.remove('lead-active');
                submitBtn.classList.remove('btn-submit-wa');
                successDiv.style.display = '';
                successDiv.scrollIntoView({behavior: 'smooth', block: 'nearest'});

                if (openWA && waMsg) {
                  setTimeout(function() {
                    window.open('https://wa.me/919754444450?text=' + encodeURIComponent(waMsg), '_blank');
                  }, 400);
                }
              } catch (fetchErr) {
                showErr('name', 'Something went wrong. Please try again or call us directly.');
              } finally {
                btnText.style.display    = '';
                btnLoading.style.display = 'none';
                btnText.innerHTML = cb.checked
                  ? '<i class="fa-brands fa-whatsapp me-2"></i>Send &amp; Open WhatsApp'
                  : '<i class="fa-solid fa-paper-plane me-2"></i>Send Message';
                submitBtn.disabled = false;
              }
            });
          })();
          </script>
        </div>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
